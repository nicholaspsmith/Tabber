{
  "manifest_version": 3,
  "name": "Tabber",
  "version": "0.1.0",
  "description": "Convert guitar audio from browser tabs to Guitar Pro tablature",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:7485/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
